{% extends "../layout.njk" %}

{% block questions %}
    {{ formPageDateInput(
        {
            hint: {
                text: page.questions.accommodationStartDate.hint
            },
            fieldName: "accommodationStartDate",
            fieldset: {
                legend: {
                    text: page.title,
                    classes: "govuk-fieldset__legend--l",
                    isPageHeading: true
                }
            },
            items: dateFieldValues('accommodationStartDate', errors)
        },
        fetchContext()
    ) }}
{% endblock %}

{% block button %}
    {{ govukButton({
        text: "Save and continue"
    }) }}
{% endblock %}
