{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% extends "../partials/layout.njk" %}

{% set pageTitle = "Home - " + applicationName %}
{% set mainClasses = "app-container govuk-body" %}

{% block beforeContent %}
  {% if backUrl %}
    {{ govukBackLink({
      text: "Back",
      href: backUrl
    }) }}
  {% endif %}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">Use this service to apply for short-term accommodation for people being released, recalled, bailed or leaving an approved premises with no suitable accommodation.</p>

      <h2 class="govuk-heading-m">Who is eligible</h2>

      <p class="govuk-body">The applicant must:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>be 18 or over</li>
        <li>be low, medium or high risk</li>
        <li>not be very high risk</li>
        <li>not be on police bail for, cautioned for, convicted of, or charged with offences mentioned in Schedule 3 of the Sexual Offences Act 2003</li>
        <li>not have broken UK immigration laws (except overstaying)</li>
        <li>not have ‘no recourse to public funds’</li>
      </ul>

      <h2 class="govuk-heading-m govuk-!-margin-top-4">What you’ll need</h2>

      <p class="govuk-body">You’ll need:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>their CRN</li>
        <li>verbal consent from the applicant</li>
      </ul>

      <p class="govuk-body">You’ll be asked for information about:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>personal details</li>
        <li>previous address</li>
        <li>preferred areas and exclusion zones</li>
        <li>funding and ID</li>
        <li>offence details</li>
        <li>previous unspent convictions</li>
        <li>health needs</li>
        <li>risks to self or others</li>
        <li>bail conditions and hearing information</li>
      </ul>

      {% call govukInsetText({
        classes: "guidance-panel"
      }) %}
        <p class="govuk-!-margin-bottom-0">Emergency referrals must be made before 4pm.</p>
      {% endcall %}

      <p class="govuk-body govuk-!-margin-top-7">You can save your progress and return to the application at any time.</p>

      {{ govukButton({
          text: "Start now",
          preventDoubleClick: true,
          classes: "govuk-!-margin-top-2",
          href: nextUrl
      }) }}
    </div>
  </div>

{% endblock %}