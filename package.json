{
  "name": "hmpps-community-accommodation-tier-2-bail-ui",
  "version": "0.0.1",
  "description": "HMPPS Community Accommodation Tier 2 Bail Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-community-accommodation-tier-2-bail-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "watch-ts": "tsc -w",
    "build": "node esbuild-configs/esbuild.config.js --build",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild-configs/esbuild.config.js --build --watch\" \"node esbuild-configs/esbuild.config.js --dev-server\"",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild-configs/esbuild.config.js  --build --watch \" \"node esbuild-configs/esbuild.config.js --dev-test-server\"",
    "start-test-wiremock": "docker compose -f docker-compose-test.yml up -d",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "test:integration:ci": "cypress run --config video=false $TEST_RUN_ARGS",
    "test:integration:ui:ci": "cypress open --e2e --browser electron",
    "test:integration:local": "npm run start-test-wiremock && npx start-server-and-test start-feature http://localhost:3007/ping test:integration:ci",
    "test:integration:local:ui": "npm run start-test-wiremock && npx start-server-and-test start-feature:dev http://localhost:3007/ping test:integration:ui:ci",
    "test:e2e": "npx playwright test --project=setupDev --project=dev",
    "test:e2e:workflow": "npx playwright test --project=workflow",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:e2e:local": "npx playwright test --project=setupLocal --project=local",
    "test:e2e:local:ui": "npm run test:e2e:local -- --ui",
    "install-playwright": "npx playwright install",
    "clean": "rm -rf dist node_modules",
    "rebuild": "npm run clean && npm i && npm run build",
    "generate-types": "script/generate-types",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!@faker-js/faker/)"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest"
      ]
    },
    "collectCoverageFrom": [
      "server/**/*.{ts,js,jsx,mjs}"
    ],
    "testMatch": [
      "<rootDir>/(server|job)/**/?(*.)(cy|test).{ts,js,jsx,mjs}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/server/testutils/jest.setup.ts"
    ],
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test_results/jest/"
        }
      ],
      [
        "./node_modules/jest-html-reporter",
        {
          "outputPath": "test_results/unit-test-reports.html"
        }
      ]
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "node",
      "ts"
    ]
  },
  "lint-staged": {
    "*.{ts,js,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@golevelup/ts-jest": "^0.7.0",
    "@ministryofjustice/frontend": "^5.2.1",
    "@ministryofjustice/hmpps-audit-client": "^1.1.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@playwright/test": "^1.63.0",
    "@sentry/node": "^7.120.4",
    "agentkeepalive": "^4.6.0",
    "applicationinsights": "2.9.8",
    "body-parser": "^2.3.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^7.1.1",
    "csurf": "^1.11.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fflate": "^0.8.3",
    "fishery": "^2.4.0",
    "govuk-frontend": "^5.14.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jquery": "^3.7.1",
    "jsonpath-plus": "10.4.0",
    "jwt-decode": "^4.0.0",
    "method-override": "^3.0.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "path-to-regexp": "^8.4.2",
    "prom-client": "^15.1.3",
    "qs": "^6.16.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "start-server-and-test": "^2.1.5",
    "static-path": "^0.0.4",
    "superagent": "^10.4.1",
    "url-value-parser": "^2.2.0"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^4.0.5",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-probation-integration-e2e-tests": "1.297.0",
    "@pact-foundation/pact": "^17.1.4",
    "@pactflow/openapi-pact-comparator": "^1.15.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/csurf": "^1.11.5",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/node": "26.6.4",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "axe-core": "^4.13.0",
    "chokidar": "^3.6.0",
    "concurrently": "^10.0.5",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-multi-reporters": "^2.0.5",
    "esbuild": "^0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-diff": "^29.7.0",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^16.0.0",
    "jest-pact": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^14.0.17",
    "prettier": "^3.9.9",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "csurf": {
      "cookie": "1.0.2"
    },
    "argparse": "^2.0.1",
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.4",
    "moment": "^2.31.0",
    "proxy-addr": "^2.0.8",
    "@opentelemetry/core": "^2.11.0",
    "shell-quote": "^1.12.0"
  }
}
